@prefix nccr: <https://nccrdataplatform.ccdi.cancer.gov/vocab#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix d: <https://nccrdataplatform.ccdi.cancer.gov/datasource/> .
@prefix v: <https://nccrdataplatform.ccdi.cancer.gov/variable/> .
@prefix s: <https://nccrdataplatform.ccdi.cancer.gov/valueset/> .
@prefix c: <https://nccrdataplatform.ccdi.cancer.gov/code/> .
# Offline fixture for the nine-source smoke test. Invented numbers; it reproduces the
# quirks of the real metadata: variables with no value set, an all-uncounted source
# (MCE months), a label that equals the record count (PHARM duration), a label collision
# (CTC scope9802Public) and a value with no count inside a counted variable (COG).

d:ctc a nccr:DataSource ; nccr:sourceId "CTC" ;
    nccr:sourceLabel "Consolidated Tumor Case" ; nccr:totalRecordCount 1000 .
v:ctc-sex a nccr:Variable ; rdfs:label "Sex" ;
    nccr:sourceColumn "sex" ; nccr:semanticType "lookup_value" ;
    nccr:belongsToSource d:ctc ;
    nccr:hasValueSet s:ctc-sex .
s:ctc-sex a skos:ConceptScheme .
c:ctc-sex-1 a skos:Concept, nccr:CodeValue ; skos:inScheme s:ctc-sex ; skos:notation "1" ; skos:prefLabel "Male"@en ; nccr:recordCount 520 .
c:ctc-sex-2 a skos:Concept, nccr:CodeValue ; skos:inScheme s:ctc-sex ; skos:notation "2" ; skos:prefLabel "Female"@en ; nccr:recordCount 480 .
v:ctc-vitalStatusRecode a nccr:Variable ; rdfs:label "Vital status" ;
    nccr:sourceColumn "vitalStatusRecode" ; nccr:semanticType "lookup_value" ;
    nccr:belongsToSource d:ctc ;
    nccr:hasValueSet s:ctc-vitalStatusRecode .
s:ctc-vitalStatusRecode a skos:ConceptScheme .
c:ctc-vitalStatusRecode-1 a skos:Concept, nccr:CodeValue ; skos:inScheme s:ctc-vitalStatusRecode ; skos:notation "1" ; skos:prefLabel "Alive"@en ; nccr:recordCount 700 .
c:ctc-vitalStatusRecode-4 a skos:Concept, nccr:CodeValue ; skos:inScheme s:ctc-vitalStatusRecode ; skos:notation "4" ; skos:prefLabel "Dead"@en ; nccr:recordCount 300 .
v:ctc-tumorRecordNumber a nccr:Variable ; rdfs:label "Tumor record number" ;
    nccr:sourceColumn "tumorRecordNumber" ; nccr:semanticType "string" ;
    nccr:belongsToSource d:ctc .
v:ctc-scope9802Public a nccr:Variable ; rdfs:label "Scope 9802" ;
    nccr:sourceColumn "scope9802Public" ; nccr:semanticType "lookup_value" ;
    nccr:belongsToSource d:ctc ;
    nccr:hasValueSet s:ctc-scope9802Public .
s:ctc-scope9802Public a skos:ConceptScheme .
c:ctc-scope9802Public-0 a skos:Concept, nccr:CodeValue ; skos:inScheme s:ctc-scope9802Public ; skos:notation "0" ; skos:prefLabel "* 0-9"@en ; nccr:recordCount 100 .
c:ctc-scope9802Public-1 a skos:Concept, nccr:CodeValue ; skos:inScheme s:ctc-scope9802Public ; skos:notation "1" ; skos:prefLabel "* 0-9"@en ; nccr:recordCount 200 .

d:abm a nccr:DataSource ; nccr:sourceId "ABM" ;
    nccr:sourceLabel "Area-Based Measures" ; nccr:totalRecordCount 1000 .
v:abm-rucaC a nccr:Variable ; rdfs:label "RUCA" ;
